{
  "name": "photolock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --config vite.singlefile.config.ts",
