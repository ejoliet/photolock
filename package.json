    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "exifreader": "4.45.2",
    "libheif-js": "1.23.2",
    "fflate": "0.8.3",
    "@noble/ed25519": "3.2.0",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plugin-pwa": "1.3.0",
    "typescript": "latest",
    "vitest": "latest",
    "eslint": "latest",
    "typescript-eslint": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "jsdom": "latest"
